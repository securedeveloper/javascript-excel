{
  "name": "javascript-excel-workspace",
  "private": true,
  "description": "Workspace for the javascript-excel library and its playground.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm -w packages/javascript-excel run build && npm -w apps/playground run build",
    "test": "npm -w packages/javascript-excel run test",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm -w packages/javascript-excel run lint",
    "smoke": "npm -w packages/javascript-excel run smoke",
    "consumer-ts": "npm -w packages/javascript-excel run consumer-ts",
    "test:release": "node --test \"scripts/*.test.mjs\"",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund",
    "bench": "npm -w packages/javascript-excel run bench --"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
