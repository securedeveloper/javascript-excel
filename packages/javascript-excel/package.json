{
  "name": "javascript-excel",
  "version": "2.0.0-alpha.3",
  "private": false,
  "description": "Read and write .xlsx and .csv files in browsers, Web Workers and Node. 2.0 is a from-scratch rewrite in progress.",
  "keywords": [
    "excel",
    "xlsx",
    "csv",
    "spreadsheet",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Afzal Ahmad",
    "url": "https://github.com/securedeveloper"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/securedeveloper/javascript-excel.git",
    "directory": "packages/javascript-excel"
  },
  "bugs": {
    "url": "https://github.com/securedeveloper/javascript-excel/issues"
  },
  "homepage": "https://github.com/securedeveloper/javascript-excel#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./read": {
      "import": {
        "types": "./dist/read.d.ts",
        "default": "./dist/read.js"
      },
      "require": {
        "types": "./dist/read.d.cts",
        "default": "./dist/read.cjs"
      }
    },
    "./csv": {
      "import": {
        "types": "./dist/csv.d.ts",
        "default": "./dist/csv.js"
      },
      "require": {
        "types": "./dist/csv.d.cts",
        "default": "./dist/csv.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "require": {
        "types": "./dist/dom.d.cts",
        "default": "./dist/dom.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      }
    },
    "./render": {
      "import": {
        "types": "./dist/render.d.ts",
        "default": "./dist/render.js"
      },
      "require": {
        "types": "./dist/render.d.cts",
        "default": "./dist/render.cjs"
      }
    },
    "./format": {
      "import": {
        "types": "./dist/format.d.ts",
        "default": "./dist/format.js"
      },
      "require": {
        "types": "./dist/format.d.cts",
        "default": "./dist/format.cjs"
      }
    },
    "./import": {
      "import": {
        "types": "./dist/import.d.ts",
        "default": "./dist/import.js"
      },
      "require": {
        "types": "./dist/import.d.cts",
        "default": "./dist/import.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.dom.json",
    "lint": "publint --strict",
    "smoke": "node scripts/smoke-pack.mjs",
    "consumer-ts": "node scripts/consumer-ts.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "bench": "node --expose-gc bench/run.mjs",
    "bench:worker": "node --expose-gc bench/worker.mjs",
    "bench:render": "node --expose-gc bench/render.mjs",
    "conformance:artifact": "node scripts/conformance.mjs artifact",
    "conformance:doc": "node scripts/conformance.mjs doc"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.1.0",
    "happy-dom": "21.0.4",
    "playwright": "1.65.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
